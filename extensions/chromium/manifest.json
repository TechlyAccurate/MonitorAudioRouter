{
  "manifest_version": 3,
  "name": "Monitor Audio Router Bridge",
  "description": "Reports audible browser windows to the local Monitor Audio Router tray app.",
  "version": "0.1.4",
  "incognito": "spanning",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "optional_permissions": [
    "processes"
  ],
  "action": {
    "default_title": "Monitor Audio Router",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
